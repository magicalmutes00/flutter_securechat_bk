# SecureChat Backend Environment Variables
# Copy this file to .env and fill in the values

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_BASE_URL=http://localhost:8080

# WebSocket Configuration
WS_PATH=/ws
WS_PING_INTERVAL=30
WS_CONNECTION_TIMEOUT=60

# MongoDB Configuration
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DATABASE=securechat
MONGO_CONNECTION_STRING=mongodb://localhost:27017/securechat

# JWT Configuration (REQUIRED - generate a secure random string)
JWT_SECRET=your-secure-jwt-secret-min-32-chars
JWT_ISSUER=securechat-server
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRY_DAYS=30
JWT_ALGORITHM=HS256

# MessageCentral OTP Configuration (REQUIRED)
MESSAGE_CENTRAL_BASE_URL=https://api.messagecentral.com
MESSAGE_CENTRAL_API_KEY=your-messagecentral-api-key
MESSAGE_CENTRAL_CUSTOMER_ID=your-messagecentral-customer-id

# OTP Settings
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
# Set to true to generate/verify OTPs locally (no SMS) and return the code in
# the response as `dev_code`. Useful for local testing. NEVER enable in prod.
OTP_DEV_MODE=true

# File Upload Configuration
UPLOAD_DIRECTORY=uploads
UPLOAD_FOLDER_IMAGES=uploads/images
UPLOAD_FOLDER_VIDEOS=uploads/videos
UPLOAD_FOLDER_AUDIO=uploads/audio
UPLOAD_FOLDER_DOCS=uploads/docs
MAX_FILE_SIZE_BYTES=52428800

# CORS Configuration (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MINUTES=1

# Push Notifications (FCM legacy HTTP API - optional)
# Leave empty to run the server without push dispatch.
#FCM_ENDPOINT=https://fcm.googleapis.com/fcm/send
#FCM_SERVER_KEY=

# TLS (optional)
# If both paths are set the server binds HTTPS instead of plain HTTP. Point
# these at PEM files containing the certificate chain and private key.
#TLS_CERT_PATH=/etc/ssl/certs/securechat.pem
#TLS_KEY_PATH=/etc/ssl/private/securechat-key.pem
