# SecureChat Backend Environment Variables
# Copy this file to .env and fill in the values

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8081
SERVER_BASE_URL=http://localhost:8081

# WebSocket Configuration
WS_PATH=/ws
WS_PING_INTERVAL=30
WS_CONNECTION_TIMEOUT=60

# Supabase (PostgreSQL) Configuration (REQUIRED)
# Supabase Dashboard -> Project Settings -> Database -> Connection string.
# Use the "Session pooler" URI (port 5432). The schema is created
# automatically on first start. See SETUP.md.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# JWT Configuration (REQUIRED - generate a secure random string)
JWT_SECRET=your-secure-jwt-secret-min-32-chars
JWT_ISSUER=securechat-server
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRY_DAYS=30
JWT_ALGORITHM=HS256

# MessageCentral OTP Configuration (only used by the legacy /send-otp flow;
# phone auth runs through Firebase. OTP_DEV_MODE keeps the legacy flow
# functional locally without SMS credits.)
MESSAGE_CENTRAL_BASE_URL=https://api.messagecentral.com
MESSAGE_CENTRAL_API_KEY=your-messagecentral-api-key
MESSAGE_CENTRAL_CUSTOMER_ID=your-messagecentral-customer-id

# OTP Settings
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
# Set to true to generate/verify OTPs locally (no SMS) and return the code in
# the response as `dev_code`. Useful for local testing. NEVER enable in prod.
OTP_DEV_MODE=true

# Cloudinary Configuration (REQUIRED - all attachments are stored here)
# Dashboard -> Settings -> Access Keys. Files are uploaded as private
# (authenticated) assets and served via short signed URLs.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
MAX_FILE_SIZE_BYTES=52428800

# CORS Configuration (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:8081

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MINUTES=1
# Set to true when behind a reverse proxy (ngrok/nginx/LB) so rate limits
# key on the client's X-Forwarded-For address instead of the proxy's.
RATE_LIMIT_TRUST_PROXY=false

# Push Notifications (FCM legacy HTTP API - optional)
#FCM_ENDPOINT=https://fcm.googleapis.com/fcm/send
#FCM_SERVER_KEY=

# Firebase Authentication (project bound to ID tokens)
FIREBASE_PROJECT_ID=your-firebase-project-id

# WebRTC (served to clients via GET /api/rtc/config; TURN optional but
# recommended for calls behind symmetric NAT)
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
#TURN_SERVER_URL=turn:your-turn-server:3478
#TURN_USERNAME=
#TURN_CREDENTIAL=

# TLS (optional - serve HTTPS/wss when both paths are set)
#TLS_CERT_PATH=
#TLS_KEY_PATH=
