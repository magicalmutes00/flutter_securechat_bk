# SecureChat Backend Environment Variables
# Copy this file to .env and fill in the values

# JWT Configuration (REQUIRED)
JWT_SECRET=casbcjbaukcgacasbcaskjcbgabujgcukas

# MessageCentral OTP Configuration (REQUIRED)
MESSAGE_CENTRAL_API_KEY=your-messagecentral-api-key
MESSAGE_CENTRAL_CUSTOMER_ID=C-316E2237A7D7427

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_BASE_URL=http://localhost:8080

# WebSocket Configuration
WS_PATH=/ws
WS_PING_INTERVAL=30
WS_CONNECTION_TIMEOUT=60

# MongoDB Configuration
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DATABASE=securechat
MONGO_CONNECTION_STRING=mongodb://localhost:27017/securechat

# JWT Settings
JWT_ISSUER=securechat-server
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRY_DAYS=30
JWT_ALGORITHM=HS256

# MessageCentral OTP Settings
MESSAGE_CENTRAL_BASE_URL=https://api.messagecentral.com
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3

# File Upload Configuration
UPLOAD_DIRECTORY=uploads
UPLOAD_FOLDER_IMAGES=uploads/images
UPLOAD_FOLDER_VIDEOS=uploads/videos
UPLOAD_FOLDER_AUDIO=uploads/audio
UPLOAD_FOLDER_DOCS=uploads/docs
MAX_FILE_SIZE_BYTES=52428800

# CORS Configuration (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://192.168.1.2:8080,http://192.168.1.2:3000

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MINUTES=1
